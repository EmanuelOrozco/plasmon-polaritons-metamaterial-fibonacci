# Qué se sube al repositorio
#   src/, scripts/, tests/, configs/, notebooks/,
#   results/**/output/ (figuras), results/**/summary.json, results/comparison/tables/,
#   results/pwe/**/data/*.npz (barridos PWE: horas de cómputo, los usa la comparación),
#   docs/**/*.tex y docs/**/*.pdf, presentacion/.
# Todo lo demás se regenera con `make` o es local.

# Entorno de Python y cachés
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editores y sistema operativo
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Artefactos de LaTeX (se conservan los .tex y los PDF finales)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.nav
*.snm
*.vrb

# PDF sueltos en la raíz (los documentos viven en docs/<documento>/)
/*.pdf

# Datos regenerables en segundos: barridos TMM y metadatos de cada corrida
results/tmm/**/data/*.npz
results/**/data/metadata.json

# Material de partida externo (artículo APS y método PWE del libro): solo local
referencias/
references/
Plasmon_polaritons*.pdf
